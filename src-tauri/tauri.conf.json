{
	"bundle": {
		"active": true,
		"targets": "all",
		"windows": {
			"certificateThumbprint": null,
			"digestAlgorithm": "sha256",
			"timestampUrl": "",
			"nsis": {
				"installerIcon": "icons/icon.ico"
			}
		},
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"resources": {
			"../dist": "dist"
		},
		"externalBin": [],
		"copyright": "Copyright © 2026 Dinar Permadi Yusup (permadi.dev)",
		"publisher": "Dinar Permadi Yusup (permadi.dev)",
		"homepage": "https://narr07.github.io/niluji/",
		"category": "Education",
		"shortDescription": "Platform CBT Offline untuk Sekolah",
		"longDescription": "NILUJI — Platform ujian berbasis komputer (CBT) 100% offline untuk sekolah oleh Dinar Permadi Yusup (permadi.dev).",
		"macOS": {},
		"linux": {
			"deb": {}
		}
	},
	"build": {
		"beforeBuildCommand": "bun run generate",
		"frontendDist": "../dist",
		"beforeDevCommand": "bun run dev",
		"devUrl": "http://localhost:3000"
	},
	"productName": "Niluji",
	"version": "1.0.1",
	"identifier": "com.narr07.niluji",
	"plugins": {},
	"app": {
		"windows": [
			{
				"title": "Niluji",
				"width": 1366,
				"height": 768,
				"minWidth": 375,
				"minHeight": 812,
				"resizable": true,
				"fullscreen": false,
				"maximized": true
			}
		],
		"security": {
			"csp": {
				"default-src": "'self' ipc: http://ipc.localhost",
				"connect-src": "'self' ipc: http://ipc.localhost https://raw.githubusercontent.com https://api.github.com https://docs.google.com https://*.googleusercontent.com",
				"img-src": "'self' data: blob: https://raw.githubusercontent.com",
				"style-src": "'self' 'unsafe-inline'",
				"font-src": "'self' data:",
				"script-src": "'self' 'unsafe-inline'"
			}
		}
	}
}
