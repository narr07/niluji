{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "NILUJI Siswa",
	"mainBinaryName": "niluji-siswa",
	"version": "0.1.0",
	"identifier": "com.narr07.niluji.siswa",
	"build": {
		"beforeDevCommand": "bun run dev",
		"beforeBuildCommand": "bun run generate",
		"devUrl": "http://localhost:3000",
		"frontendDist": "../.output/public"
	},
	"app": {
		"windows": [],
		"security": {
			"csp": {
				"default-src": "'self' ipc: http://ipc.localhost",
				"connect-src": "'self' ipc: http://ipc.localhost",
				"img-src": "'self' data: blob:",
				"style-src": "'self' 'unsafe-inline'",
				"font-src": "'self' data:",
				"script-src": "'self'"
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"publisher": "Dinar Permadi Yusup",
		"homepage": "https://niluji.permadi.dev",
		"category": "Education",
		"shortDescription": "Masuk ke ujian NILUJI dari HP siswa",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"android": {
			"minSdkVersion": 24
		}
	}
}
