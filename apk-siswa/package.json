{
	"name": "niluji-siswa",
	"type": "module",
	"version": "0.1.0",
	"private": true,
	"packageManager": "bun@1.3.6",
	"description": "Aplikasi Android untuk siswa NILUJI: menyambung ke server ujian lokal dan membuka portal CBT layar penuh.",
	"author": "Dinar Permadi Yusup",
	"license": "MIT",
	"repository": "https://github.com/narr07/niluji",
	"scripts": {
		"dev": "nuxt dev",
		"generate": "nuxt generate",
		"postinstall": "nuxt prepare",
		"lint": "eslint app nuxt.config.ts",
		"lint:fix": "eslint app nuxt.config.ts --fix",
		"typecheck": "nuxt typecheck",
		"tauri": "tauri",
		"desktop:dev": "tauri dev",
		"desktop:build": "tauri build --no-bundle",
		"android:dev": "tauri android dev",
		"android:build": "tauri android build --apk",
		"test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
		"clippy": "cargo clippy --all-targets --manifest-path src-tauri/Cargo.toml -- -D warnings"
	},
	"dependencies": {
		"@nuxt/ui": "4.12.0",
		"@tauri-apps/api": "2.12.4",
		"@tauri-apps/plugin-barcode-scanner": "2.5.3",
		"nuxt": "4.6.3",
		"vue": "3.5.44",
		"vue-router": "4.6.4"
	},
	"devDependencies": {
		"@iconify-json/lucide": "1.2.149",
		"@nuxt/eslint": "1.17.0",
		"@tauri-apps/cli": "2.12.3",
		"eslint": "9.39.5",
		"typescript": "5.9.3",
		"vue-tsc": "3.3.14"
	}
}
