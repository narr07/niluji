{
	"name": "niluji",
	"type": "module",
	"version": "1.4.0",
	"private": false,
	"packageManager": "bun@1.3.6",
	"description": "NILUJI - Platform CBT offline untuk sekolah",
	"author": "narr07",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/narr07/niluji.git"
	},
	"homepage": "https://github.com/narr07/niluji",
	"bugs": {
		"url": "https://github.com/narr07/niluji/issues"
	},
	"keywords": [
		"niluji",
		"cbt",
		"ujian",
		"sekolah",
		"education",
		"nuxt",
		"tauri"
	],
	"scripts": {
		"dev": "nuxt dev",
		"generate": "nuxt generate",
		"preinstall": "npx only-allow bun",
		"postinstall": "nuxt prepare",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"typecheck": "nuxt typecheck",
		"test": "bun test tests",
		"templates:word": "bun scripts/generate-word-templates.ts",
		"test:rust": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
		"clippy": "cargo clippy --locked --all-targets --manifest-path src-tauri/Cargo.toml -- -D warnings",
		"bump": "bumpp",
		"docs:dev": "bun --cwd docs run dev",
		"docs:build": "bun --cwd docs run build:gh-pages",
		"docs:lint": "bun --cwd docs run lint",
		"tauri": "tauri",
		"tauri:dev": "npx tsx scripts/tauri-dev.ts",
		"tauri:build": "tauri build",
		"tauri:build:debug": "tauri build --debug"
	},
	"dependencies": {
		"@fontsource-variable/tiktok-sans": "5.3.0",
		"@nuxt/ui": "4.12.0",
		"@tauri-apps/api": "2.9.1",
		"@tauri-apps/plugin-dialog": "2.6.0",
		"@tauri-apps/plugin-http": "2.5.0",
		"@tauri-apps/plugin-shell": "2.3.4",
		"@tiptap/core": "3.32.2",
		"@tiptap/extension-code": "3.32.2",
		"@tiptap/extension-horizontal-rule": "3.32.2",
		"@tiptap/extension-image": "3.32.2",
		"@tiptap/extension-mention": "3.32.2",
		"@tiptap/extension-placeholder": "3.32.2",
		"@tiptap/markdown": "3.32.2",
		"@tiptap/pm": "3.32.2",
		"@tiptap/starter-kit": "3.32.2",
		"@tiptap/vue-3": "3.32.2",
		"@vueuse/integrations": "15.0.0",
		"jszip": "3.10.2",
		"nuxt": "4.6.3",
		"nuxt-charts": "2.2.3",
		"pdfjs-dist": "6.5.438",
		"qrcode": "1.5.4",
		"sortablejs": "1.15.7",
		"vue": "3.5.44",
		"vue-router": "4.6.4",
		"xlsx": "0.18.5",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@antfu/eslint-config": "7.7.3",
		"@iconify-json/lucide": "1.2.149",
		"@nuxt/eslint": "1.17.0",
		"@tauri-apps/cli": "2.12.4",
		"@types/node": "25.9.9",
		"@types/qrcode": "1.5.6",
		"@types/sortablejs": "1.15.9",
		"@vueuse/core": "14.4.0",
		"@vueuse/nuxt": "14.4.0",
		"bumpp": "10.4.1",
		"eslint": "9.39.5",
		"eslint-plugin-better-tailwindcss": "4.10.0",
		"nuxt-svgo": "4.2.6",
		"typescript": "5.9.3",
		"vue-tsc": "3.3.14"
	},
	"trustedDependencies": [
		"@parcel/watcher",
		"@tailwindcss/oxide",
		"unrs-resolver"
	]
}
